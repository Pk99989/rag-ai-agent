# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional overrides
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
DAILY_COST_ALERT_USD=1.00

# --- FastAPI backend (Phase 12) ---
# Required for real deployments: generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
# If left unset, config.py generates a random one per process start (fine for a single local dev
# run, unsafe for anything with more than one instance or that needs to survive a restart).
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=30
# Comma-separated list of origins allowed to call the API (CORS). The Streamlit UI's default
# local dev origin is included below; add your deployed UI's URL when you deploy.
API_CORS_ORIGINS=http://localhost:8501
# Where app.py (the Streamlit UI) reaches the FastAPI backend.
API_BASE_URL=http://localhost:8000

# --- Multimodal document Q&A (Phase 16) ---
# qwen/qwen3.8-27b is the current Groq vision model as of Sept 2026
# (verified against https://console.groq.com/docs/vision -- its
# predecessor, qwen/qwen3.6-27b, was deprecated and started returning a
# live 404 model_not_found error) -- JSON mode + vision, up to 3
# images/request, 20MB per-request image size limit. The two defaults
# below mirror those real API limits.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
MAX_DOCUMENT_PAGES=3
MAX_DOCUMENT_IMAGE_MB=20
