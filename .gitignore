# (see README for download instructions)
data/raw/
data/processed/
*.db
*.sqlite

# Logs
logs/
*.log

# VS Code
.vscode/

# Thesis / research-paper deliverables -- not part of the codebase
*.docx

# Stray artifact from a pip install run without quoting a version spec
# (e.g. `pip install pkg >=0.5.0` -- the shell treated >=0.5.0 as a redirect)
=0.5.0