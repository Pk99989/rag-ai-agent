# Python
.venv/
venv/
__pycache__/
*.pyc

# Secrets
.env

# Cache / local databases
.cache/
chroma_store/
bm25_index.pkl

# Phase 10 experiments/ -- isolated index built by reindex_semantic.py,
# never the production index (see experiments/reindex_semantic.py's docstring).
# experiments/results.json and evaluation/results.json are NOT ignored --
# they're kept as real, timestamped proof of the last real eval run, not
# transient build output.
experiments/chroma_store_experiments/
experiments/bm25_index_experiments.pkl

