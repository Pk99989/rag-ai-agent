FROM python:3.11-slim

WORKDIR /app

# The UI is a pure API client (Phase 13) -- it never imports rag_agent,
# chromadb, or any ML dependency, so it doesn't need the full
# requirements.txt or a built vector index. Installing only what app.py
# actually imports keeps this image small and its build fast, and means a
# UI-only change never needs to rebuild the (slow, model-downloading) API
# image.
RUN pip install --no-cache-dir streamlit>=1.35.0 requests>=2.32.0

COPY app.py .

EXPOSE 8501
ENV STREAMLIT_SERVER_HEADLESS=true

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
